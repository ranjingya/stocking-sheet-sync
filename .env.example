# 数据应用凭证：读取多维表、Wiki、电子表格并复制文件
FEISHU_DATA_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_DATA_APP_SECRET=xxxxxxxxxxxxxxxx

# 消息应用凭证：以机器人身份发送同步结果卡片
FEISHU_MESSAGE_APP_ID=cli_yyyyyyyyyyyyyyyy
FEISHU_MESSAGE_APP_SECRET=yyyyyyyyyyyyyyyy

# Redis 连接；包含密码时必须只保存在 .env 或部署平台的密钥配置中
REDIS_URL=redis://localhost:6379/0

# 多维表自动化调用 Webhook 时使用的 Bearer 密钥
WEBHOOK_SECRET=请使用_openssl_rand_hex_32_生成

# 数仓连接：供历史销量及公式预估使用，凭证由本项目独立配置
WAREHOUSE_HOST=
WAREHOUSE_PORT=3306
WAREHOUSE_DATABASE=
WAREHOUSE_USER=
WAREHOUSE_PASSWORD=
WAREHOUSE_CONNECT_TIMEOUT=10
WAREHOUSE_READ_TIMEOUT=30

# 京东自营源 MySQL：按SKU只读库存快照及历史出库指标
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DB_NAME=
MYSQL_USER=
MYSQL_PASSWORD=

# 是否自动填充新品近30天销量；新品始终跳过预测
FILL_NEW_HISTORY_ENABLED=true

# 是否自动填充老款历史销量
FILL_OLD_HISTORY_ENABLED=true

# 是否自动填充老款公式预估数量
FILL_OLD_FORECAST_ENABLED=false

# 新品预测规则待实现；开启时报告规则未实现，保留历史填充结果
FILL_NEW_FORECAST_ENABLED=false
